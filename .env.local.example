# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google OAuth Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Under "Authorized JavaScript origins" add http://localhost:3000 for local dev, plus your
# production URL once deployed. No redirect URI is needed — Google Identity Services' button flow
# uses postMessage, not a redirect. This value is public (it's sent to the browser), so it's safe
# to expose via NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: enables live company research in src/app/api/research/route.ts. Without it, that step
# honestly reports "not connected" and lets the user fill in figures themselves.
ANTHROPIC_API_KEY=

# Optional: enables "send via email" in the PDF delivery dialog (src/app/api/send-report/route.ts).
# The emails go out through Gmail's SMTP server from GMAIL_USER, signed in with an app password of
# that Google account (https://myaccount.google.com/apppasswords, needs 2-Step Verification). Keep
# the app password secret. Without both, that path honestly reports "not configured".
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: keeps the "NDI AI Employees" links in the results and PDF up to date with NDI's live
# AI Employees catalogue (read from the AI Sales Coach's /api/ai-employees, server-side only, about
# once an hour — see src/lib/aiEmployees.ts). Same value as AI_EMPLOYEES_API_KEY in the Sales Coach.
# Keep it secret: never prefix it with NEXT_PUBLIC_. Without it, the app uses the copy bundled in
# src/data/ai-employees-snapshot.json (refresh it with `npm run ai-employees:snapshot`).
AI_EMPLOYEES_API_KEY=

# Optional: the folder for saved company research (saved-research.json, see src/lib/savedResearch.ts
# and "Saved company research" in the README). Defaults to the Railway volume when one is attached
# (RAILWAY_VOLUME_MOUNT_PATH), else .data in the project.
SAVED_RESEARCH_DIR=

# Optional: the Chrome/Chromium executable that prints the PDF report (src/lib/pdf.ts). Chrome or
# Edge in their usual install folders is found automatically; the Docker image (Railway) sets
# /usr/bin/chromium.
CHROMIUM_PATH=
