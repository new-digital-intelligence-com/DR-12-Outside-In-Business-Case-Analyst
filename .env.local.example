# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google OAuth Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Under "Authorized JavaScript origins" add http://localhost:3000 for local dev, plus your
# production URL once deployed. No redirect URI is needed — Google Identity Services' button flow
# uses postMessage, not a redirect. This value is public (it's sent to the browser), so it's safe
# to expose via NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: enables live company research in src/app/api/research/route.ts. Without it, that step
# honestly reports "not connected" and lets the user fill in figures themselves.
ANTHROPIC_API_KEY=

# Optional: enables "send via email" in the PDF delivery dialog (src/app/api/send-report/route.ts),
# via Resend (https://resend.com). Without it, that path honestly reports "not configured".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
